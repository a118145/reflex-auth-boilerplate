"""Where an event comes from, checked against Reflex's real event processor.

``auth.middleware.event_origin`` rests on how Reflex 0.10.1 hands events over:
a socket event carries the handshake headers, an event a handler queues
carries nothing and inherits its context, an upload carries nothing at all.
These tests run events through ``app.event_processor`` — not a hand-built
call to the middleware — so a Reflex upgrade that changes any of it fails
here first.
"""

import asyncio
import sys
import uuid
from collections.abc import Awaitable, Callable, Iterator
from typing import Any

import pytest
from reflex.event import Event
from reflex.istate.manager.token import BaseStateToken
from reflex.state import BaseState, OnLoadInternalState, State

from {{app_name}} import {{app_name}} as app_module
from {{app_name}}.auth import middleware, security, upload_gate
from {{app_name}}.auth.cookie import COOKIE_NAME
from {{app_name}}.auth.service import Identity
from {{app_name}}.auth.state import AuthState
from {{app_name}}.states.runs_state import RunsState
from {{app_name}}.states.upload_state import UploadState

USER = Identity(session_id=1, user_id=7, email="anna@company.com", is_admin=False)
SESSION = security.token_hash("user-token")
# Reflex's client token: selects the state, proves nothing. A fresh one per
# test (see ``fakes``) — the app's state manager outlives a test.
CLIENT = ""
PAGE_LOAD = f"{OnLoadInternalState.get_full_name()}.on_load_internal"
LOAD_ALL = f"{RunsState.get_full_name()}.load_all"  # returns RunsState.refresh
REFRESH = f"{RunsState.get_full_name()}.refresh"
SET_SHARED = f"{UploadState.get_full_name()}.set_shared_with_all"

Seen = list[tuple[str, str]]
Script = Callable[[Callable[[Event], Awaitable[None]]], Awaitable[None]]


@pytest.fixture(autouse=True)
def fakes(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
    monkeypatch.setattr(middleware, "lookup_session", {SESSION: USER}.get)
    # RunsState.refresh would read the database; what it loads is not the point.
    monkeypatch.setattr("{{app_name}}.states.runs_state._load_rows", lambda owner, scope: [])
    monkeypatch.setattr(upload_gate, "_grants", {})
    monkeypatch.setattr(sys.modules[__name__], "CLIENT", uuid.uuid4().hex)
    yield


def _socket_event(name: str, *, sid: str, signed_in: bool, **extra: Any) -> Event:
    """An event as ``EventNamespace.on_event`` enqueues it: Reflex has put the
    connection's headers and sid into the router data; ``extra`` stands for
    keys the browser added itself."""
    cookie = "theme=dark" + (f"; {COOKIE_NAME}=user-token" if signed_in else "")
    router_data = {
        "headers": {"cookie": cookie, "origin": "http://localhost:3000"},
        "sid": sid,
        "token": CLIENT,
        "pathname": "/404",
        "asPath": "/some/page",
        "query": {},
        **extra,
    }
    return Event(name=name, payload={}, router_data=router_data)


def _drive(script: Script) -> tuple[Seen, BaseState]:
    """Run ``script`` against the app's event processor. Returns the origin
    the middleware saw for each event, and the root state afterwards."""
    app = app_module.app
    gate = app._middlewares[0]
    seen: Seen = []
    preprocess = gate.preprocess

    async def spy(app: Any, state: Any, event: Event) -> Any:
        seen.append((event.name, middleware.event_origin(event)))
        return await preprocess(app=app, state=state, event=event)

    async def main() -> BaseState:
        async with app._setup_event_processor():

            async def send(event: Event) -> None:
                await asyncio.wait_for(await app.event_processor.enqueue(CLIENT, event), 10)
                await app.event_processor.join(10)  # and everything it chained

            await script(send)
            token = BaseStateToken(ident=CLIENT, cls=State)
            async with app.state_manager.modify_state(token) as root:
                await root.get_state(AuthState)
                await root.get_state(UploadState)
                return root

    gate.preprocess = spy  # type: ignore[method-assign]
    try:
        with app.set_contexts():
            root = asyncio.run(main())
    finally:
        gate.preprocess = preprocess  # type: ignore[method-assign]
    return seen, root


def _auth(root: BaseState) -> AuthState:
    return asyncio.run(root.get_state(AuthState))


def _upload(root: BaseState) -> UploadState:
    return asyncio.run(root.get_state(UploadState))


def test_socket_and_chained_events_are_told_apart() -> None:
    async def script(send: Callable[[Event], Awaitable[None]]) -> None:
        await send(_socket_event(LOAD_ALL, sid="A", signed_in=True))

    seen, root = _drive(script)
    assert seen == [(LOAD_ALL, "socket"), (REFRESH, "chained")]
    # The chained event carried no cookie and did not sign anyone out.
    assert _auth(root).is_authenticated


def test_another_socket_without_the_cookie_cannot_keep_the_identity() -> None:
    """The client token alone, plus a flag only this process may set, used to
    be enough to stay signed in as the state's last user."""

    async def script(send: Callable[[Event], Awaitable[None]]) -> None:
        await send(_socket_event(PAGE_LOAD, sid="A", signed_in=True))
        forged = {middleware._STRIPPED: True}
        await send(_socket_event(PAGE_LOAD, sid="B", signed_in=False, **forged))
        await send(_socket_event(SET_SHARED, sid="B", signed_in=False, **forged))

    _seen, root = _drive(script)
    assert not _auth(root).is_authenticated
    assert _auth(root)._identity() is None
    assert _upload(root).shared_with_all is False


def _detached(value: bool = True) -> Event:
    """An event as ``POST /_upload`` builds it: no router data at all."""
    return Event(name=SET_SHARED, payload={"value": value})


def _sign_in_then_detached(send: Callable[[Event], Awaitable[None]]) -> Awaitable[None]:
    async def run() -> None:
        await send(_socket_event(PAGE_LOAD, sid="A", signed_in=True))
        await send(_detached())

    return run()


def test_detached_event_needs_a_grant(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(upload_gate, "ENFORCED", True)
    seen, root = _drive(_sign_in_then_detached)
    assert seen[-1] == (SET_SHARED, "detached")
    assert _upload(root).shared_with_all is False


def test_detached_event_runs_with_a_grant_for_this_session(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setattr(upload_gate, "ENFORCED", True)
    upload_gate._open(CLIENT, SESSION)
    _seen, root = _drive(_sign_in_then_detached)
    assert _upload(root).shared_with_all is True


def test_grant_for_another_session_does_not_count(monkeypatch: pytest.MonkeyPatch) -> None:
    # Someone signed in as themselves, uploading into another person's state.
    monkeypatch.setattr(upload_gate, "ENFORCED", True)
    upload_gate._open(CLIENT, security.token_hash("someone-else"))
    _seen, root = _drive(_sign_in_then_detached)
    assert _upload(root).shared_with_all is False


def test_detached_event_passes_where_the_gate_cannot_be_enforced(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    # Split origins (development): the upload request cannot carry the cookie.
    monkeypatch.setattr(upload_gate, "ENFORCED", False)
    _seen, root = _drive(_sign_in_then_detached)
    assert _upload(root).shared_with_all is True


def test_detached_event_never_signs_in(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(upload_gate, "ENFORCED", True)
    upload_gate._open(CLIENT, SESSION)

    async def script(send: Callable[[Event], Awaitable[None]]) -> None:
        await send(_detached())

    _seen, root = _drive(script)
    assert not _auth(root).is_authenticated
    assert _upload(root).shared_with_all is False
