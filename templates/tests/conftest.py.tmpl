"""Shared fixtures: a throwaway database, and a shareable kind of the tests'
own, so the sharing rules are exercised whatever kinds the app declares.

Also: **a Reflex deprecation fails the tests.** Reflex (0.11) reports
deprecations only as records of the ``reflex.deprecation`` logger, which
pytest hides. Installed here, before the app is imported, so a deprecated
API used at import time is caught too.
"""

import logging
from collections.abc import Iterator
from pathlib import Path

import pytest
from sqlalchemy import UniqueConstraint
from sqlmodel import Field, Session, SQLModel, create_engine



class ReflexDeprecationError(Exception):
    """A deprecated Reflex API was used. The message is Reflex's own."""


# Every deprecation seen, also those a caller swallowed: checked at the end.
REFLEX_DEPRECATIONS: list[str] = []


class _FailOnDeprecation(logging.Handler):
    def emit(self, record: logging.LogRecord) -> None:
        message = record.getMessage()
        REFLEX_DEPRECATIONS.append(message)
        # Raised at the call site, so the failing test names the culprit.
        raise ReflexDeprecationError(message)


logging.getLogger("reflex.deprecation").addHandler(_FailOnDeprecation(logging.WARNING))


def pytest_sessionfinish(session: pytest.Session, exitstatus: int) -> None:
    # Reflex reports each deprecation once per process; one raised where an
    # exception is caught would otherwise pass unnoticed.
    if REFLEX_DEPRECATIONS:
        print("\nReflex deprecations:\n" + "\n".join(REFLEX_DEPRECATIONS))
        session.exitstatus = pytest.ExitCode.TESTS_FAILED


# The app is imported only now, with the deprecation guard in place.
from {{app_name}}.auth import models as auth_models  # noqa: E402, F401  (authuser, for the foreign keys)
from {{app_name}}.service import sharing  # noqa: E402
from {{app_name}}.service.sharing import Shareable  # noqa: E402

ALICE, BOB, CAROL = 1, 2, 3


class Probe(SQLModel, table=True):
    id: int | None = Field(default=None, primary_key=True)
    name: str
    owner_id: int = Field(foreign_key="authuser.id", index=True)
    shared_with_all: bool = False


class ProbeShare(SQLModel, table=True):
    __table_args__ = (UniqueConstraint("probe_id", "user_id"),)

    id: int | None = Field(default=None, primary_key=True)
    probe_id: int = Field(foreign_key="probe.id", index=True)
    user_id: int = Field(foreign_key="authuser.id", index=True)


class ProbeGroupShare(SQLModel, table=True):
    __table_args__ = (UniqueConstraint("probe_id", "group_id"),)

    id: int | None = Field(default=None, primary_key=True)
    probe_id: int = Field(foreign_key="probe.id", index=True)
    group_id: int = Field(foreign_key="usergroup.id", index=True)


PROBES = Shareable(
    kind="probe",
    owner_word="owner",
    model=Probe,
    owner_column="owner_id",
    user_share=ProbeShare,
    group_share=ProbeGroupShare,
    target_column="probe_id",
)


@pytest.fixture(autouse=True)
def probe_kind(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(sharing, "KINDS", (*sharing.KINDS, PROBES))


@pytest.fixture
def db(tmp_path: Path) -> Iterator[Session]:
    # A database of the test's own, so creating every table is right here.
    # SQLite does not enforce foreign keys by default: people are bare ids.
    engine = create_engine(f"sqlite:///{tmp_path / 'test.db'}")
    SQLModel.metadata.create_all(engine)
    with Session(engine) as session:
        yield session
    engine.dispose()


def probe(db: Session, owner: int, name: str = "P") -> int:
    item = Probe(name=name, owner_id=owner)
    db.add(item)
    db.commit()
    db.refresh(item)
    return item.id or 0
