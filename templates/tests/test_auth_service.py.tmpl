def test_wrong_password_and_unknown_address_look_alike(db: Session) -> None:
    assert service.admin_login(db, ADMIN, "nope", client_ip=IP, user_agent="")[1] == "invalid"
    assert (
        service.admin_login(db, "who@firma.de", ADMIN_PASSWORD, client_ip=IP, user_agent="")[1]
        == "invalid"
    )


def test_lockout_per_ip_then_global(db: Session, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(settings, "ADMIN_MAX_FAILURES_PER_IP", 2)
    monkeypatch.setattr(settings, "ADMIN_MAX_FAILURES_GLOBAL", 3)
    for _ in range(2):
        service.admin_login(db, ADMIN, "nope", client_ip=IP, user_agent="")
    # Locked for this IP even with the right password.
    assert (
        service.admin_login(db, ADMIN, ADMIN_PASSWORD, client_ip=IP, user_agent="")[1] == "locked"
    )
    assert (
        service.admin_login(db, ADMIN, "nope", client_ip="198.51.100.2", user_agent="")[1]
        == "invalid"
    )
    # Three failures overall: locked everywhere.
    assert (
        service.admin_login(db, ADMIN, ADMIN_PASSWORD, client_ip="198.51.100.3", user_agent="")[1]
        == "locked"
    )


