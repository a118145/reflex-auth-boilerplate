# --- sessions


def test_logout_ends_one_session_logout_everywhere_ends_all(db: Session) -> None:
    a, b, c = (sign_in(db, "anna@firma.de") for _ in range(3))
    service.logout(db, a, everywhere=False, client_ip=IP)
    assert service.resolve_session(db, a) is None
    assert service.resolve_session(db, b) is not None
    service.logout(db, b, everywhere=True, client_ip=IP)
    assert service.resolve_session(db, b) is None
    assert service.resolve_session(db, c) is None


def test_expired_session_does_not_resolve(db: Session) -> None:
    token_hash = sign_in(db, "anna@firma.de")
    db.exec(update(AuthSession).values(expires_at=now() - timedelta(seconds=1)))
    db.commit()
    assert service.resolve_session(db, token_hash) is None


def test_admin_revokes_a_session(db: Session) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    token_hash = sign_in(db, "anna@firma.de")
    identity = service.resolve_session(db, token_hash)
    assert identity is not None
    service.revoke_session(db, identity.session_id, actor_user_id=admin_id)
    assert service.resolve_session(db, token_hash) is None


# --- block


def test_block_ends_sessions_and_stops_links(db: Session) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    token_hash = sign_in(db, "anna@firma.de")
    anna = user_id(db, token_hash)
    service.set_blocked(db, anna, True, actor_user_id=admin_id)
    assert service.resolve_session(db, token_hash) is None
    assert (
        service.request_link(db, "anna@firma.de", client_ip="198.51.100.9", redirect_to="/")[1]
        == "blocked"
    )
    service.set_blocked(db, anna, False, actor_user_id=admin_id)
    sign_in(db, "anna@firma.de")


def test_admin_account_cannot_be_blocked(db: Session) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    with pytest.raises(service.AdminActionError):
        service.set_blocked(db, admin_id, True, actor_user_id=admin_id)


# --- merge


def test_merge_moves_addresses_and_signs_both_out(db: Session) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    old = sign_in(db, "anna.alt@firma.de")
    new = sign_in(db, "anna.neu@firma.de")
    source, target = user_id(db, old), user_id(db, new)
    seen: list[tuple[int, int]] = []
    merge_hooks.MERGE_HOOKS.append(lambda _db, s, t: seen.append((s, t)))
    try:
        service.merge_users(db, source, target, actor_user_id=admin_id)
    finally:
        merge_hooks.MERGE_HOOKS.pop()
    assert seen == [(source, target)]
    assert service.resolve_session(db, old) is None and service.resolve_session(db, new) is None
    # Either address now signs in to the surviving account.
    assert user_id(db, sign_in(db, "anna.alt@firma.de")) == target
    assert user_id(db, sign_in(db, "anna.neu@firma.de")) == target
    events = db.exec(
        select(AuthAuditEvent).where(col(AuthAuditEvent.event) == "admin.users_merged")
    ).all()
    assert len(events) == 1 and events[0].subject_user_id == target


@pytest.mark.parametrize("which", ["same", "admin", "blocked"])
def test_merge_refusals(db: Session, which: str) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    a = user_id(db, sign_in(db, "a@firma.de"))
    b = user_id(db, sign_in(db, "b@firma.de"))
    if which == "blocked":
        service.set_blocked(db, b, True, actor_user_id=admin_id)
    source, target = {"same": (a, a), "admin": (a, admin_id), "blocked": (a, b)}[which]
    with pytest.raises(service.AdminActionError):
        service.merge_users(db, source, target, actor_user_id=admin_id)


