# --- delete


def test_delete_hands_data_over_and_removes_the_account(db: Session) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    gone = sign_in(db, "gone@company.com")
    source, target = user_id(db, gone), user_id(db, sign_in(db, "heir@company.com"))
    db.add(Probe(name="P", owner_id=source))
    db.add(GroupMember(group_id=1, user_id=source))
    db.commit()
    service.delete_user(db, source, target, actor_user_id=admin_id)
    assert db.exec(select(Probe.owner_id)).all() == [target]
    assert not db.exec(select(GroupMember)).all()
    assert service.resolve_session(db, gone) is None
    assert not db.exec(select(AuthUserEmail).where(col(AuthUserEmail.user_id) == source)).all()
    event = db.exec(
        select(AuthAuditEvent).where(col(AuthAuditEvent.event) == "admin.user_deleted")
    ).one()
    assert event.subject_user_id == source and f"new_owner={target}" in event.detail
    # The address may sign up again, as a new, empty account.
    assert user_id(db, sign_in(db, "gone@company.com")) not in (source, target)


@pytest.mark.parametrize("which", ["self", "same", "missing", "admin", "blocked"])
def test_delete_refusals(db: Session, which: str) -> None:
    admin_id = user_id(db, admin_sign_in(db))
    a = user_id(db, sign_in(db, "a@company.com"))
    b = user_id(db, sign_in(db, "b@company.com"))
    if which == "blocked":
        service.set_blocked(db, b, True, actor_user_id=admin_id)
    cases = {"self": (a, b, a), "same": (a, a, admin_id), "missing": (a, 999, admin_id)}
    cases |= {"admin": (a, admin_id, admin_id), "blocked": (a, b, admin_id)}
    source, target, actor = cases[which]
    with pytest.raises(service.AdminActionError):
        service.delete_user(db, source, target, actor_user_id=actor)
    assert db.get(AuthUser, a) is not None


