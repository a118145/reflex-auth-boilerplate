def _admin_outcome(db: Session, password: str, ip: str) -> str:
    return service.admin_login(db, ADMIN, password, client_ip=ip, user_agent="")[1]


def test_lockout_is_per_ip(db: Session, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(settings, "ADMIN_MAX_FAILURES_PER_IP", 2)
    for _ in range(2):
        assert _admin_outcome(db, "nope", IP) == "invalid"
    # Locked for this IP even with the right password.
    assert _admin_outcome(db, ADMIN_PASSWORD, IP) == "locked"
    assert _admin_outcome(db, ADMIN_PASSWORD, "198.51.100.2") == "ok"


def test_many_failures_elsewhere_do_not_lock_the_admin_out(
    db: Session, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(settings, "ADMIN_MAX_FAILURES_PER_IP", 3)
    monkeypatch.setattr(settings, "ADMIN_MAX_FAILURES_GLOBAL", 4)
    for n in range(4):
        assert _admin_outcome(db, "nope", f"198.51.100.{n}") == "invalid"
    events = [e.event for e in db.exec(select(AuthAuditEvent)).all()]
    assert events.count("auth.admin_under_attack") == 1
    # Under attack every IP has a single failure: those four are spent ...
    assert _admin_outcome(db, ADMIN_PASSWORD, "198.51.100.0") == "locked"
    # ... a fifth guesser gets one try and no more ...
    assert _admin_outcome(db, "nope", "198.51.100.50") == "invalid"
    assert _admin_outcome(db, ADMIN_PASSWORD, "198.51.100.50") == "locked"
    # ... and the admin, from an address that has not failed, still gets in.
    assert _admin_outcome(db, ADMIN_PASSWORD, "203.0.113.7") == "ok"
    events = [e.event for e in db.exec(select(AuthAuditEvent)).all()]
    assert events.count("auth.admin_under_attack") == 1


