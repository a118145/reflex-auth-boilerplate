def test_rate_limit_per_address_and_per_ip(db: Session) -> None:
    for _ in range(settings.LINK_RATE_LIMIT):
        assert (
            service.request_link(db, "anna@company.com", client_ip=IP, redirect_to="/")[1] == "sent"
        )
    assert (
        service.request_link(db, "anna@company.com", client_ip="198.51.100.1", redirect_to="/")[1]
        == "rate_limited"
    )
    # Same IP, other address: the per-IP limit is exhausted too.
    assert (
        service.request_link(db, "bert@company.com", client_ip=IP, redirect_to="/")[1]
        == "rate_limited"
    )


def test_requests_past_the_per_ip_limit_are_dropped_unaudited(
    db: Session, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(settings, "LINK_REQUESTS_PER_IP", 3)

    def request(ip: str = IP) -> str:
        # A foreign domain: never issues a token, so the link limits never bite.
        return service.request_link(db, "eve@evil.test", client_ip=ip, redirect_to="/")[1]

    def audited() -> list[str]:
        return [e.event for e in db.exec(select(AuthAuditEvent)).all()]

    assert [request() for _ in range(3)] == ["domain_not_allowed"] * 3
    assert [request() for _ in range(5)] == ["ip_flooding"] * 5
    # Three requests, one note that the limit was hit — and then nothing more.
    assert audited() == [service.LINK_REQUESTED] * 3 + [service.LINK_FLOOD]
    # Even a request that would otherwise get a link.
    token, outcome = service.request_link(db, "anna@company.com", client_ip=IP, redirect_to="/")
    assert (token, outcome) == (None, "ip_flooding")
    assert request("198.51.100.1") == "domain_not_allowed"
    # The window passes.
    db.exec(update(AuthAuditEvent).values(created_at=now() - settings.LINK_RATE_WINDOW * 2))
    db.commit()
    assert request() == "domain_not_allowed"


def test_rate_limit_counts_over_its_own_window_not_the_link_lifetime(db: Session) -> None:
    def age_all(by: timedelta) -> None:
        db.exec(update(AuthLinkToken).values(created_at=now() - by))
        db.commit()

    def request() -> str:
        return service.request_link(db, "anna@company.com", client_ip=IP, redirect_to="/")[1]

    for _ in range(settings.LINK_RATE_LIMIT):
        assert request() == "sent"
    # Long expired, still inside the window: a short link lifetime must not
    # loosen the limit.
    age_all(settings.LINK_EXPIRATION + timedelta(minutes=1))
    assert settings.LINK_EXPIRATION < settings.LINK_RATE_WINDOW
    assert request() == "rate_limited"
    age_all(settings.LINK_RATE_WINDOW + timedelta(minutes=1))
    assert request() == "sent"


