"""Auth service against a real, throwaway SQLite database."""

from collections.abc import Iterator
from datetime import timedelta
from pathlib import Path

import pytest
from sqlalchemy import update
from sqlmodel import Session, SQLModel, col, create_engine, select

from {{app_name}}.auth import merge_hooks, security, service, settings
from {{app_name}}.auth.models import (
    AUTH_TABLES,
    AuthAuditEvent,
    AuthLinkToken,
    AuthLoginAttempt,
    AuthSession,
    AuthUserEmail,
    now,
)

ADMIN = "admin@firma.de"
ADMIN_PASSWORD = "correct horse battery"
IP = "192.0.2.10"


@pytest.fixture(scope="module")
def admin_hash() -> str:
    return security.hash_password(ADMIN_PASSWORD)


@pytest.fixture
def db(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, admin_hash: str) -> Iterator[Session]:
    monkeypatch.setattr(settings, "ALLOWED_DOMAINS", frozenset({"firma.de"}))
    monkeypatch.setattr(settings, "ADMIN_EMAIL", ADMIN)
    monkeypatch.setattr(settings, "ADMIN_PASSWORD_HASH", admin_hash)
    monkeypatch.setattr(settings, "LINK_RATE_LIMIT", 5)
    monkeypatch.setattr(settings, "LINK_RATE_LIMIT_PER_IP", 5)
    engine = create_engine(f"sqlite:///{tmp_path / 'auth.db'}")
    # Filtered create_all: only the auth tables, never every registered model.
    tables = [SQLModel.metadata.tables[t.__name__.lower()] for t in AUTH_TABLES]
    SQLModel.metadata.create_all(engine, tables=tables)
    with Session(engine) as session:
        yield session
    engine.dispose()


def sign_in(db: Session, email: str, redirect_to: str = "/") -> str:
    token, outcome = service.request_link(db, email, client_ip=IP, redirect_to=redirect_to)
    assert outcome == "sent" and token is not None
    result = service.redeem_link(db, token, client_ip=IP, user_agent="pytest")
    assert result is not None
    return security.token_hash(result[0])


def admin_sign_in(db: Session) -> str:
    token, outcome = service.admin_login(
        db, ADMIN, ADMIN_PASSWORD, client_ip=IP, user_agent="pytest"
    )
    assert outcome == "ok" and token is not None
    return security.token_hash(token)


def user_id(db: Session, token_hash: str) -> int:
    identity = service.resolve_session(db, token_hash)
    assert identity is not None
    return identity.user_id


# --- magic links


def test_link_signs_in_and_creates_the_account_once(db: Session) -> None:
    assert db.exec(select(AuthUserEmail)).first() is None  # requesting creates nothing
    first = sign_in(db, "Anna@Firma.de", "/data")
    second = sign_in(db, "anna@firma.de")
    assert user_id(db, first) == user_id(db, second)
    assert len(db.exec(select(AuthUserEmail)).all()) == 1


def test_redirect_target_survives_the_round_trip(db: Session) -> None:
    token, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/data/7")
    assert token is not None
    result = service.redeem_link(db, token, client_ip=IP, user_agent="")
    assert result is not None and result[1] == "/data/7"


def test_link_is_single_use(db: Session) -> None:
    token, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")
    assert token is not None
    assert service.peek_link(db, token)  # peeking spends nothing
    assert service.peek_link(db, token)
    assert service.redeem_link(db, token, client_ip=IP, user_agent="") is not None
    assert not service.peek_link(db, token)
    assert service.redeem_link(db, token, client_ip=IP, user_agent="") is None


def test_new_link_kills_the_previous_one(db: Session) -> None:
    old, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")
    new, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")
    assert old is not None and new is not None
    assert service.redeem_link(db, old, client_ip=IP, user_agent="") is None
    assert service.redeem_link(db, new, client_ip=IP, user_agent="") is not None


def test_expired_link_is_refused(db: Session) -> None:
    token, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")
    assert token is not None
    db.exec(update(AuthLinkToken).values(expires_at=now() - timedelta(seconds=1)))
    db.commit()
    assert service.redeem_link(db, token, client_ip=IP, user_agent="") is None


@pytest.mark.parametrize(
    ("email", "outcome"),
    [
        ("not an address", "invalid_address"),
        ("eve@evil.test", "domain_not_allowed"),
        ("eve@sub.firma.de", "domain_not_allowed"),
        (ADMIN, "admin_address"),
    ],
)
def test_refused_requests_issue_no_token(db: Session, email: str, outcome: str) -> None:
    token, got = service.request_link(db, email, client_ip=IP, redirect_to="/")
    assert (token, got) == (None, outcome)


def test_rate_limit_per_address_and_per_ip(db: Session) -> None:
    for _ in range(settings.LINK_RATE_LIMIT):
        assert service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")[1] == "sent"
    assert (
        service.request_link(db, "anna@firma.de", client_ip="198.51.100.1", redirect_to="/")[1]
        == "rate_limited"
    )
    # Same IP, other address: the per-IP limit is exhausted too.
    assert (
        service.request_link(db, "bert@firma.de", client_ip=IP, redirect_to="/")[1]
        == "rate_limited"
    )


def test_link_issued_before_domain_was_removed_is_refused(
    db: Session, monkeypatch: pytest.MonkeyPatch
) -> None:
    token, _ = service.request_link(db, "anna@firma.de", client_ip=IP, redirect_to="/")
    assert token is not None
    monkeypatch.setattr(settings, "ALLOWED_DOMAINS", frozenset({"other.de"}))
    assert service.redeem_link(db, token, client_ip=IP, user_agent="") is None


