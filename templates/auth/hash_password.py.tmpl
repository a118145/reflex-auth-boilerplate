"""Print an ``ADMIN_PASSWORD_HASH`` value.

    uv run python -m {{app_name}}.auth.hash_password

Reads the password twice without echoing it. Only the hash is printed; put it
in the environment as ``ADMIN_PASSWORD_HASH``. The password itself is never
stored anywhere.
"""

import getpass
import sys

from .security import hash_password

MIN_LENGTH = 12


def main() -> int:
    password = getpass.getpass("Admin password: ")
    if len(password) < MIN_LENGTH:
        print(f"Use at least {MIN_LENGTH} characters.", file=sys.stderr)
        return 1
    if getpass.getpass("Repeat: ") != password:
        print("The passwords do not match.", file=sys.stderr)
        return 1
    print(hash_password(password))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
