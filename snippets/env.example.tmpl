# Authentication settings. Copy to .env (never commit it) or set them in the
# container environment. Reflex does not read .env by itself: use
# `docker run --env-file .env`, compose `env_file:`, or `set -a; . ./.env`.
# Every value is read by the backend only; none reaches the browser.

# --- Who may sign in by magic link (exact domains, comma-separated)
AUTH_ALLOWED_DOMAINS={{allowed_domains}}

# --- Admin (password login only, at /admin-login — not linked anywhere)
# Generate the hash with:  uv run python -m {{app_name}}.auth.hash_password
# The hash uses ":" separators, so it is safe in compose files and .env as is.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Where the app is reachable. Links in e-mails and redirects are built
# from these, never from what a browser sends. With `--single-port` both are
# the same public URL, e.g. https://app.company.com
REFLEX_DEPLOY_URL=http://localhost:3000
REFLEX_API_URL=http://localhost:8000

# --- Lifetimes and limits (defaults shown)
# AUTH_LINK_EXPIRATION_SECONDS=1800
# AUTH_SESSION_EXPIRATION_SECONDS=604800
# AUTH_LINK_RATE_LIMIT=5
# AUTH_LINK_RATE_LIMIT_PER_IP=5        # raise if many users share one IP (NAT)
# AUTH_SESSION_RECHECK_SECONDS=60
# AUTH_ADMIN_MAX_FAILURES_PER_IP=5
# AUTH_ADMIN_MAX_FAILURES_GLOBAL=20
# AUTH_ADMIN_LOCKOUT_SECONDS=900
# AUTH_TRUSTED_PROXIES=                 # proxy IPs whose X-Forwarded-For is believed

# --- Mail: console (development only) | smtp | mailgun | graph
MAIL_TRANSPORT={{mail_transport}}
MAIL_FROM=

# smtp — e.g. Microsoft 365: smtp.office365.com, 587, starttls
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# mailgun (EU accounts: https://api.eu.mailgun.net)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_API_URL=https://api.mailgun.net

# graph — Microsoft Graph sendMail, app-only (see auth/mail/graph.py)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=noreply@company.com
