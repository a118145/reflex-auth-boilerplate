# Authentication: the /_auth HTTP routes set and clear the session cookie,
# AuthMiddleware gates every event, and a daily task purges dead auth rows.
# Index 0: the cookie must leave the router data before anything else sees
# the state, and nothing may run ahead of the gate. See auth/__init__.py.
app = rx.App(api_transformer=auth_api())
app.add_middleware(AuthMiddleware(), index=0)
app.register_lifespan_task(purge_expired_daily)
log.info("auth.enabled", tables=len(auth_models.AUTH_TABLES))
