

def _own_origins() -> list[str]:
    """The origins the page is served from: the only ones that may call the
    backend. Reflex's default is "*". Derived from the same two variables
    Reflex reads, with its defaults; REFLEX_CORS_ALLOWED_ORIGINS overrides
    (a sandbox or tunnel whose page origin is neither of them)."""
    urls = (
        os.environ.get("REFLEX_DEPLOY_URL") or "http://localhost:3000",
        os.environ.get("REFLEX_API_URL") or "http://localhost:8000",
    )
    origins = []
    for url in urls:
        parts = urlsplit(url)
        origin = f"{parts.scheme}://{parts.netloc}"
        if parts.scheme and parts.netloc and origin not in origins:
            origins.append(origin)
    return origins
